{
  // Codespace leve só para o simulador: imagem Python enxuta em vez da
  // imagem "universal" padrão (~11 GB por Codespace, que estoura a cota
  // gratuita de armazenamento do GitHub).
  "name": "AeroTower - simulador",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -r simulador/requirements.txt",
  "secrets": {
    "MQTT_USER": { "description": "Usuário do broker HiveMQ" },
    "MQTT_PASS": { "description": "Senha do broker HiveMQ" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
